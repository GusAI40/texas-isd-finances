{
  "version": 2,
  "rubric_version": "semantic-painted-marks-v2",
  "rubric": "Inventory direct visible text and painted data marks under #welcome, #picker-section, and #dash. Score only Range rectangles and actual SVG/HTML marks; never score card, plot, SVG, Canvas, hero, or padded wrapper boxes.",
  "analytic_roots": [
    { "selector": "#welcome", "required": true },
    { "selector": "#picker-section", "required": true },
    { "selector": "#dash", "required": true }
  ],
  "exclusions": [
    { "selector": "header, #masthead, nav, #sectionnav", "reason": "global or section navigation" },
    { "selector": "input, button, .results, .chips, .exports, .lensbar, .finder, .econ-mine label, .econ-mine-in", "reason": "input or interactive control" },
    { "selector": "footer, #ai-note, .warnbar", "reason": "footer, legal, or availability chrome" },
    { "selector": "details, .tbl, .a11y", "reason": "expanded disclosure or alternate accessible table" },
    { "selector": ".welcome-cta, .welcome-strip, .finder-ask", "reason": "global navigation or finder affordance" },
    { "selector": ".icon-sprite, svg.ico, svg[aria-hidden=\"true\"]", "reason": "decorative icon" }
  ],
  "prose": [
    "p",
    ".support",
    ".exec",
    ".cmpnote",
    ".rest",
    ".gwhat",
    ".gstake",
    ".ghint",
    ".note",
    ".ask",
    ".hero-why",
    ".hero-truth",
    ".hero-sub",
    ".welcome-sub",
    ".welcome-who",
    ".econ-note",
    ".bond-close",
    ".bond-detail",
    ".dyk-txt",
    ".econ-sub",
    ".econ-method",
    ".plain",
    ".credential",
    ".cite",
    "figcaption",
    ".flagcard",
    ".onechild .ask",
    ".pipeline",
    ".missing-state",
    ".trust li"
  ],
  "visual_text": [
    ".eyebrow",
    "#welcome-h, #picker-title, #dname",
    "#bond-bigidea, #bond-b1-title, #bond-b2-title, #bond-b3-title, #bond-b4-title, #bond-b5-title",
    "#dollar-title, #outcomes-title, #econ-title, #tk-title, #eq-title, #insights-title",
    "#trend-title, #peers-title, #money-title, #object-title, #program-title, #flags-title, #turnaround-title, #state-title",
    ".econ-h, .lever > h4, #cmphead",
    ".proof",
    ".hero-kpis",
    ".kpi .label, .kpi .value, .kpi .delta",
    ".metric-meta",
    ".metric-value",
    ".metric-detail",
    ".metric-caveat",
    ".chart-status",
    ".credential span",
    ".tx-legend",
    ".stat > b, .stat > i",
    ".beat .big",
    ".econ-big",
    ".econ-legend",
    ".bond-key",
    ".bond-bundle",
    ".cmprow",
    ".penny-legend",
    ".guide .gcat, .guide .gbig, .guide .gsub, .guide .gcodes",
    ".guide-facts[data-visual-component=\"penny-comparison\"] small, .guide-facts[data-visual-component=\"penny-comparison\"] b",
    ".numeric-facts[data-visual-component=\"peer-outlier-values\"] small, .numeric-facts[data-visual-component=\"peer-outlier-values\"] b",
    ".numeric-facts[data-visual-component=\"turnaround-period-values\"] small, .numeric-facts[data-visual-component=\"turnaround-period-values\"] b",
    ".numeric-facts[data-visual-component=\"anomaly-values\"] small, .numeric-facts[data-visual-component=\"anomaly-values\"] b",
    ".flagcard > .record-type",
    ".delta",
    ".nums",
    ".who",
    ".stat-note",
    ".wow-kick, .wow-num, .dyk-tag",
    ".onechild .oh",
    ".econ-card h4",
    ".flagcard strong, .flagcard .nums",
    ".bond-detail .bd-h, .bond-detail .bd-m",
    ".driver .dl, .driver .dv, .driver .tag, .driver .dcmp",
    ".lrow > span, .lrow > b",
    ".legend",
    "#comparebar",
    ".vsbar .row > span, .vsbar .row > b",
    "th, td, caption"
  ],
  "graphic_roots": [
    ".pennies[role=\"img\"]",
    "svg[role=\"img\"]:not([aria-hidden=\"true\"])",
    "canvas",
    ".cmpbars",
    ".vsbar",
    ".econ-split",
    ".dbar",
    ".bars"
  ],
  "html_marks": [
    ".pennies > i",
    ".bar > span",
    ".vsbar .fill",
    ".econ-split > i",
    ".dbar > i",
    ".bars .lrow > i",
    ".econ-legend i",
    ".bond-key i"
  ]
}
