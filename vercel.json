{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/isd-intelligence",
      "schedule": "0 11 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "texas-isd-finances.vercel.app"
        }
      ],
      "destination": "https://txisd.dev/$1",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/district-geo",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=600"
        },
        {
          "key": "Vercel-CDN-Cache-Control",
          "value": "public, s-maxage=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/bonds/texas",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=600"
        },
        {
          "key": "Vercel-CDN-Cache-Control",
