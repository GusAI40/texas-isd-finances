{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/isd-intelligence",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/cron/outreach-drain",
      "schedule": "30 14 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "texas-isd-finances.vercel.app"
        }
      ],
      "destination": "https://txisd.dev/$1",
      "permanent": true
    }
  ],
  "functions": {
    "api/index.py": {
      "maxDuration": 60
    }
  }
}
