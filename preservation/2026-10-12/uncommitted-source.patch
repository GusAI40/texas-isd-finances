+def test_bond_tool_description_matches_committed_election_years(client):
+    """A discoverable coverage claim must include the actual ballot record."""
+    data = json.loads((ROOT / "static" / "bond_data.json").read_text(encoding="utf-8"))
+    years = [e["year"] for rec in data["districts"].values() for e in rec["elections"]]
+    tools = rpc(client, "tools/list", {}).json()["result"]["tools"]
+    description = next(t["description"] for t in tools if t["name"] == "district_bonds")
+    coverage = re.search(r"\b(\d{4})-(\d{4})\b", description)
+    assert coverage, "district_bonds must state its available election-year coverage"
+    assert tuple(map(int, coverage.groups())) == (min(years), max(years)), (
+        "district_bonds description must match the first and last committed election years"
+    )
+
+
+def test_bond_tool_returns_the_committed_dallas_record_unchanged(client):
+    data = json.loads((ROOT / "static" / "bond_data.json").read_text(encoding="utf-8"))
+    result = call(client, "district_bonds", {"district_number": DALLAS}).json()["result"]
+    assert result["isError"] is False
+    assert result["structuredContent"] == {
+        **data["districts"][DALLAS], "limits": data["meta"].get("limits", [])
+    }
+
